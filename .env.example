BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
OANOR_API_KEY=YOUR_OANOR_API_KEY

OANOR_BASE_URL=https://api.oanor.com/irr-api

# Cache aggregate market responses in RAM to reduce API usage.
CACHE_TTL_SECONDS=60

# Gold/coin symbol list changes rarely.
SYMBOLS_CACHE_TTL_SECONDS=21600

HTTP_TIMEOUT_SECONDS=15

LOG_DIR=logs
LOG_LEVEL=INFO
